{
  "_version": "1.82.0",
  "sap.app": {
    "id": "com.mteschke.booktrail.booktrail",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:lrop",
      "version": "1.20.4",
      "toolsId": "a3a668cc-9733-48cd-9546-a31e28106edf"
    },
    "dataSources": {
      "mainService": {
        "uri": "/odata/v4/catalog/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "odataVersion": "4.01"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.150.1",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.fe.templates": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "com.mteschke.booktrail.booktrail.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "@i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "uri": "i18n/i18n.properties"
      }
    },
    "resources": {
      "css": []
    },
    "routing": {
      "config": {},
      "routes": [
        {
          "pattern": ":?query:",
          "name": "BooksList",
          "target": "BooksList"
        },
        {
          "pattern": "Tags:?query:",
          "name": "TagsList",
          "target": "TagsList"
        },
        {
          "pattern": "Tags({key}):?query:",
          "name": "TagsObjectPage",
          "target": "TagsObjectPage"
        },
        {
          "pattern": "Books({key}):?query:",
          "name": "BooksObjectPage",
          "target": "BooksObjectPage"
        }
      ],
      "targets": {
        "TagsList": {
          "type": "Component",
          "id": "TagsList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/Tags",
              "variantManagement": "None",
              "initialLoad": "Enabled",
              "navigation": {
                "Tags": {
                  "detail": {
                    "route": "TagsObjectPage"
                  }
                }
              },
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "ResponsiveTable"
                  }
                }
              }
            }
          }
        },
        "TagsObjectPage": {
          "type": "Component",
          "id": "TagsObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "contextPath": "/Tags",
              "editableHeaderContent": false
            }
          }
        },
        "BooksList": {
          "type": "Component",
          "id": "BooksList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/Books",
              "variantManagement": "None",
              "initialLoad": "Enabled",
              "showDraftToggle": false,
              "navigation": {
                "Books": {
                  "detail": {
                    "route": "BooksObjectPage"
                  }
                }
              },
              "views": {
                "paths": [
                  {
                    "key": "all",
                    "label": "All",
                    "annotationPath": "com.sap.vocabularies.UI.v1.SelectionPresentationVariant#All"
                  },
                  {
                    "key": "finished",
                    "label": "Finished",
                    "annotationPath": "com.sap.vocabularies.UI.v1.SelectionPresentationVariant#Finished"
                  },
                  {
                    "key": "unfinished",
                    "label": "Unfinished",
                    "annotationPath": "com.sap.vocabularies.UI.v1.SelectionPresentationVariant#Unfinished"
                  }
                ]
              },
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "ResponsiveTable"
                  },
                  "actions": {
                    "markAsRead": {
                      "text": "Mark as Read",
                      "press": "com.mteschke.booktrail.booktrail.ext.BookActions.onMarkAsRead",
                      "requiresSelection": true
                    },
                    "setPriority": {
                      "text": "Set Priority",
                      "press": "com.mteschke.booktrail.booktrail.ext.BookActions.onSetPriority",
                      "requiresSelection": true
                    }
                  },
                  "columns": {
                    "CoverColumn": {
                      "header": "",
                      "width": "4rem",
                      "importance": "High",
                      "position": {
                        "placement": "Before",
                        "anchor": "DataField::title"
                      },
                      "template": "com.mteschke.booktrail.booktrail.ext.CoverColumn"
                    },
                    "PriorityColumn": {
                      "header": "Priority",
                      "width": "6em",
                      "importance": "High",
                      "position": {
                        "placement": "Before",
                        "anchor": "DataField::read"
                      },
                      "template": "com.mteschke.booktrail.booktrail.ext.PriorityColumn"
                    },
                    "TagsColumn": {
                      "header": "Tags",
                      "width": "12em",
                      "importance": "High",
                      "position": {
                        "placement": "After",
                        "anchor": "DataField::read"
                      },
                      "template": "com.mteschke.booktrail.booktrail.ext.TagsColumn"
                    },
                    "DataFieldForAnnotation::DataPoint::Rating": {
                      "width": "10rem"
                    }
                  }
                }
              }
            }
          }
        },
        "BooksObjectPage": {
          "type": "Component",
          "id": "BooksObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": true,
              "contextPath": "/Books",
              "content": {
                "header": {
                  "actions": {
                    "suggestInfo": {
                      "press": "com.mteschke.booktrail.booktrail.ext.SuggestActions.onSuggestInfo",
                      "text": "Suggest Info",
                      "enabled": "{= ${ui>/isEditable} !== true }"
                    }
                  }
                }
              },
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.FieldGroup#Status": {
                  "fields": {
                    "CustomRating": {
                      "template": "com.mteschke.booktrail.booktrail.ext.RatingField",
                      "label": "Rating",
                      "visible": "{read}"
                    },
                    "CustomPriority": {
                      "template": "com.mteschke.booktrail.booktrail.ext.PriorityField",
                      "label": "Priority"
                    }
                  }
                },
                "tags/@com.sap.vocabularies.UI.v1.LineItem#Tags": {
                  "actions": {
                    "manageTagsAction": {
                      "text": "Manage Tags",
                      "press": "com.mteschke.booktrail.booktrail.ext.TagsActions.onManageTags"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "transactional"
  },
  "sap.fe": {
    "app": {
      "enableLazyLoading": true
    }
  }
}