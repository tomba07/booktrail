{
  "name": "booktrail",
  "version": "1.0.0",
  "description": "A simple CAP project.",
  "repository": "<Add your repository here>",
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@cap-js/sqlite": "^3",
    "@sap/cds": "^10.0.5",
    "express": "^4"
  },
  "devDependencies": {
    "@cap-js/cds-types": "^0.10.0",
    "@sap/cds-dk": "^10.0.6",
    "cds-plugin-ui5": "^0.13.0"
  },
  "cds": {
    "requires": {
      "auth": "dummy",
      "db": {
        "kind": "sqlite",
        "credentials": {
          "url": "/data/booktrail.sqlite",
          "[development]": {
            "url": ":memory:"
          }
        }
      }
    }
  },
  "scripts": {
    "start": "node server.js",
    "watch-booktrail": "cds watch --open com.mteschke.booktrail.booktrail/index.html?sap-ui-xx-viewCache=false --livereload false"
  },
  "workspaces": [
    "app/*"
  ],
  "sapux": [
    "app/booktrail"
  ]
}
